{
  "description": "jevmem: queue each finished turn for Jev (Stop, async), add the relevant project memories to each prompt (UserPromptSubmit), and check Bash, Edit and Write calls against the project's saved rules before they run (PreToolUse). Runs the separate jevmem command-line tool; does nothing in a project until `jevmem enable`.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jevmem-hook.sh\" hook --plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jevmem-hook.sh\" --detach hook --plugin",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/jevmem-hook.sh\" --guard hook --plugin",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
