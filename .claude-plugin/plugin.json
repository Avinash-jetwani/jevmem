{
  "name": "jevmem",
  "version": "0.5.2",
  "description": "Automatic project memory for Claude Code. After each message, TypeSafe's Jev decides whether it's worth remembering and saves it as one line in JEVMEM.md in your repo. Opt-in per project.",
  "author": {
    "name": "Avinash Jetwani",
    "url": "https://github.com/Avinash-jetwani"
  },
  "homepage": "https://github.com/Avinash-jetwani/jevmem#readme",
  "repository": "https://github.com/Avinash-jetwani/jevmem",
  "license": "MIT",
  "keywords": [
    "memory",
    "project-memory",
    "decisions",
    "jev",
    "mcp"
  ],
  "mcpServers": {
    "jevmem": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/hooks/jevmem-hook.sh",
        "mcp"
      ]
    }
  }
}
