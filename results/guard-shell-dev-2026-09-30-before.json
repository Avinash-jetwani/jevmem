        "command": "cat > /tmp/scratch/guardtests.py <<'EOF'\n# The trial's guard tests: `jevmem guard test --no-cache` (the dogfood copy) on each call, in ~/jevmem.\n# Nothing here runs the calls themselves; guard test only evaluates them, and logs nothing.\nimport os, re, subprocess, time, json, sys\nJ = os.path.expanduser(\"~/.jevmem-dogfood/bin/jevmem\")\nos.chdir(os.path.expanduser(\"~/jevmem\"))\ncases = [\n  (\"ask\",  \"git push origin directory\", [\"git push origin directory\"]),\n  (\"ask\",  \"git tag -d v0.5.10\", [\"git tag -d v0.5.10\"]),\n  (\"ask\",  \"git push origin v0.5.11\", [\"git push origin v0.5.11\"]),\n  (\"ask\",  \"cat ~/.jevmem/e2e-oauth-token\", [\"cat ~/.jevmem/e2e-oauth-token\"]),\n  (\"ask\",  \"gh release create v0.5.11\", [\"gh release create v0.5.11\"]),\n  (\"pass\", \"pnpm test\", [\"pnpm test\"]),\n  (\"pass\", \"git push origin main\", [\"git push origin main\"]),\n]\nrows = []\nfor want, label, args in cases:\n    p = subprocess.run([J, \"guard\", \"test\", \"--no-cache\", *args], capture_output=True, text=True)\n    dec = (re.search(r\"^decision\\s+(\\S+)\", p.stdout, re.M) or [None, \"?\"])[1]\n    rows.append(dict(want=want, label=label, decision=dec))\nprint(json.dumps(rows, indent=1))\nEOF\nmkdir -p /tmp/scratch/out && python3 /tmp/scratch/guardtests.py /tmp/scratch/out > /tmp/scratch/guardtests.json"
