{
  "description": "jevmem: queue each finished turn for Jev (Stop, async and detached) and inject the relevant memories on every prompt (UserPromptSubmit).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/jevmem-hook.sh", "hook", "--plugin"], "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/jevmem-hook.sh", "--detach", "hook", "--plugin"], "async": true, "timeout": 20 }
        ]
      }
    ]
  }
}
