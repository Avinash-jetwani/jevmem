{
  "name": "jevmem",
  "version": "0.7.8",
  "description": "Shared project rules and memory for AI coding agents: JEVMEM.md in your repo, read by Claude Code, Cursor and Codex, with a guard that checks Claude's commands against your rules before they run.",
  "mcpName": "io.github.Avinash-jetwani/jevmem",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jevmem": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "PRIVACY.md",
    "docs",
    "hooks"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:live": "JEVMEM_LIVE=1 vitest run",
    "lint": "tsc --noEmit && eslint src test",
    "pane:check": "claude plugin validate --strict pane && claude plugin test pane",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude",
    "cursor",
    "cursor-plugin",
    "codex",
    "mcp",
    "mcp-server",
    "ai-agents",
    "coding-agents",
    "ai-coding",
    "agent-rules",
    "guardrails",
    "project-rules",
    "project-memory",
    "agent-memory",
    "ai-memory",
    "memory",
    "claude-md",
    "agents-md",
    "context-engineering",
    "hooks",
    "team",
    "developer-tools",
    "jev",
    "typesafe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avinash-jetwani/jevmem.git"
  },
  "homepage": "https://avinash-jetwani.github.io/jevmem/",
  "bugs": {
    "url": "https://github.com/Avinash-jetwani/jevmem/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "marked": "^18.0.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
